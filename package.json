    "jest": "^30.4.2",
    "oxlint": "^1.75.0",
    "ts-jest": "^29.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
