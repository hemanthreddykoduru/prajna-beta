# Committed (not .local) deliberately — none of this is a secret. A Cognito
# user-pool id and app-client id are public by design (see src/config.ts); the
# pool itself enforces auth. This file exists so CI (.github/workflows/deploy.yml)
# has these values at build time — previously only .env.production.local
# (gitignored) had them, so every CI-triggered build shipped with an empty
# config and silently fell back to bundled mock data (isBackendConfigured=false).
#
# NOTE: these point at the shared DEV backend (api stage "dev") because that is
# the only backend that exists today — see AGENTS.md "Production has not been
# done". When a real prod backend is deployed, update these to the prod API
# Gateway URL and prod Cognito pool, and this file's values start meaning what
# its name says.
VITE_API_URL=https://uvremjs67f.execute-api.ap-south-2.amazonaws.com/dev
VITE_COGNITO_USER_POOL_ID=ap-south-2_f75Z7kbEH
VITE_COGNITO_CLIENT_ID=6evdb5tpam1cja99q1p7vqe8le
VITE_AWS_REGION=ap-south-2
